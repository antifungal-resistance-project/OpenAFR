# ChEMBL bioactivity cache for the verified-inactive decoy construction: ~88k raw
# activity records, re-pullable with scripts/make_verified_inactives.py fetch. The
# git-tracked memory is the built data/ligands/verified_inactives.smi + its provenance
# stanza (record counts + cache sha256), not the raw dump.
work/chembl/

# gstack tooling is installed per-developer, not vendored
.claude/skills/gstack/

# Early-warning snapshots (issue #21): each is a multi-MB per-release NCBI pull,
# regenerable with scripts/snapshot_ncbi_auris.py. The git-tracked memory is the
# small INDEX.tsv manifest (release tag, date, count, content hash) + README, not
# the blobs themselves.
data/earlywarning/snapshots/*.tsv
!data/earlywarning/snapshots/INDEX.tsv

# Python
__pycache__/
*.pyc
.venv/
work/dock_batch_output.txt

# pytest-cov artifact
.coverage
